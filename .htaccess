# ============================================================
# Bosk Furniture - .htaccess  (root)
# SEO, performance & security hardening
# ============================================================

# ---- Enable mod_rewrite ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ============================================================
    # CANONICAL DOMAIN — always end up at https://www.boskfurniture.com
    # in a SINGLE 301 hop (never chained http->https->www):
    #   http://boskfurniture.com      -> https://www.boskfurniture.com  (rule 1)
    #   https://boskfurniture.com     -> https://www.boskfurniture.com  (rule 1)
    #   http://www.boskfurniture.com  -> https://www.boskfurniture.com  (rule 2)
    #   https://www.boskfurniture.com -> (already canonical, no redirect)
    # Two separate rules (rather than one with mixed AND/OR conditions)
    # so the logic is unambiguous and each case fires exactly one 301.
    # ============================================================
    RewriteCond %{HTTP_HOST} ^boskfurniture\.com$ [NC]
    RewriteRule ^(.*)$ https://www.boskfurniture.com/$1 [L,R=301]

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^www\.boskfurniture\.com$ [NC]
    RewriteRule ^(.*)$ https://www.boskfurniture.com/$1 [L,R=301]

    # Remove trailing slash from URLs (except real directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # ============================================================
    # /home alias  ->  index.php  (so http://.../bosk/home opens home page)
    # Kept above the generic clean-URL rules so it matches first.
    # ============================================================
    RewriteRule ^home/?$ index.php [L]

    # ============================================================
    # CLEAN URLS — strip the .php extension everywhere
    # /bosk/about-us.php   ->  /bosk/about-us         (browser redirect)
    # /bosk/about-us       ->  /bosk/about-us.php     (internal rewrite)
    # /bosk/index.php      ->  /bosk/                 (home canonical)
    # ============================================================

    # 1) Canonicalize the home page:
    #    /index.php  or  /index  →  /  (works at any sub-folder depth)
    #    Only on GET so AJAX POSTs aren't broken.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(.*/)index(?:\.php)?[?\s] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 2) Redirect /something.php → /something  (visitor address bar gets cleaned)
    #    Skip the AJAX endpoint folder (back/) and the admin panel (Admin/)
    #    because their forms POST directly to *.php and a 301 would drop the POST body.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{REQUEST_URI} !/back/   [NC]
    RewriteCond %{REQUEST_URI} !/Admin/  [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^\s?]+)\.php[?\s] [NC]
    RewriteRule ^ %1 [R=301,L]

    # ============================================================
    # SLUG ROUTING
    # Slug URLs are flat (one path segment) because the site's assets
    # and nav links are relative — a nested /product/<slug> would break
    # them. Every rule below is guarded by "the .php file does not
    # exist", so a real page always wins over a slug and adding a new
    # page can never be shadowed by a product or post of the same name.
    # ============================================================

    # NOTE: `DirectorySlash Off` lives in blog/.htaccess, not here. A
    # `blog/` directory exists on disk (blog authoring source), so mod_dir
    # would 301 /blog to /blog/ and shadow the /blog route below. Scoping the
    # directive to that one directory keeps /Admin, /css and /images
    # redirecting to their trailing-slash form as before.

    # 2a) /blog-full-list -> /blog is a 301 issued by blog-full-list.php.
    #     It is NOT done here: a relative substitution in an R=301 rule
    #     resolves against the filesystem path when the site is served from a
    #     sub-folder, producing a redirect to a literal C:/xampp2/... URL.

    # 2b) Legacy ?astringdata parameter URLs -> resolved to slug URLs in PHP.
    #     Internal rewrite (no R flag) so REQUEST_URI still holds the
    #     original path, which legacy-redirect.php uses to tell the
    #     three legacy page types apart.
    RewriteCond %{QUERY_STRING} (^|&)astringdata2?= [NC]
    RewriteRule ^(details|product|shop|project-details)/?$ legacy-redirect.php [L]

    # 2c) Blog index
    RewriteRule ^blog/?$ blog-full-list.php [L]

    # 2d) Blog post:  /blog-<slug>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php !-f
    RewriteRule ^blog-([a-z0-9-]+)/?$ details.php?slug=$1 [L,QSA]

    # 2e) Product:  /product-<slug>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php !-f
    RewriteRule ^product-([a-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]

    # 2e2) Project:  /project-<slug>
    #      The .php guard keeps /project-details resolving to its own page.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php !-f
    RewriteRule ^project-([a-z0-9-]+)/?$ project-details.php?slug=$1 [L,QSA]

    # 2f) Category:  top-level reserved slugs -> shop.php
    #     These are the primary commercial landing pages, so they get the
    #     shortest possible path.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php !-f
    RewriteRule ^(modular-kitchens|wardrobes|storage-beds|tv-units|sofas|other-comforts)/?$ shop.php?cat_slug=$1 [L,QSA]

    # 3) Internally serve /something as /something.php when the .php file exists.
    #    Skipped for /back/ and /Admin/ so those paths still resolve by their real names.
    RewriteCond %{REQUEST_URI} !/back/   [NC]
    RewriteCond %{REQUEST_URI} !/Admin/  [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    # Custom 404 page
    ErrorDocument 404 /404.php
</IfModule>

# ---- Compression (Gzip) — faster loads = better SEO ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/woff font/woff2 application/vnd.ms-fontobject application/x-font-ttf
</IfModule>

# ---- Browser caching — Core Web Vitals friendly ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 month"
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType application/x-javascript      "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/gif                     "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/font-woff         "access plus 1 year"
    ExpiresByType application/x-font-ttf        "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/xml               "access plus 1 hour"
    ExpiresByType text/xml                      "access plus 1 hour"
</IfModule>

# ---- Cache-Control headers (fallback) ----
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpe?g|png|gif|webp|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>

    # ---- Security headers ----
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ---- Block access to sensitive files ----
<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|\.env|\.git|\.htaccess|connect\.php)$">
    Require all denied
</FilesMatch>

# ---- Make robots.txt and sitemap.xml directly accessible ----
<FilesMatch "(robots\.txt|sitemap\.xml)$">
    Require all granted
</FilesMatch>

# ---- Set default charset (SEO friendly) ----
AddDefaultCharset UTF-8

# ---- Disable directory browsing ----
Options -Indexes

# ---- PHP error display off (production) ----
<IfModule mod_php7.c>
    php_flag display_errors off
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors off
</IfModule>
